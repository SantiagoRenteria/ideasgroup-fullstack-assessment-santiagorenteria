# Valores por defecto para levantar el proyecto sin configuracion manual (docker compose up).
# Estos NO son secretos reales: es un entorno de evaluacion local y desechable.
# Nunca versionar un .env real con credenciales de un entorno productivo.

# --- PostgreSQL ---
POSTGRES_DB=gestion_proyectos
POSTGRES_USER=gestion_proyectos_user
POSTGRES_PASSWORD=ChangeMe_DevOnly123
POSTGRES_PORT=5432

# --- Backend API (.NET 8) ---
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000

# --- JWT ---
JWT_SECRET=ThisIsADevOnlySecretKeyChangeInProduction_32chars
JWT_ISSUER=GestionProyectos.Api
JWT_AUDIENCE=GestionProyectos.Client
JWT_EXPIRATION_MINUTES=60

# --- Password pepper ---
# ADVERTENCIA: los 2 usuarios semilla (migracion InitialCreate) tienen su hash de
# contraseña calculado con este pepper. Si lo cambias despues de aplicar la migracion,
# esos usuarios ya no podran loguearse (ver docs/decisions/arquitectura-decisiones.md §11.2).
PASSWORD_PEPPER=DevOnlyPepper_ChangeCarefully_2026

# --- CORS ---
CORS_ALLOWED_ORIGIN=http://localhost:4200

# --- Frontend SPA (Angular + nginx) ---
SPA_PORT=4200
