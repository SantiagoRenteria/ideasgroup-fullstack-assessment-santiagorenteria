                        "method": "DELETE",
                        "url": {
                            "raw": "{{baseUrl}}/columns/00000000-0000-0000-0000-000000000000",
                            "host": ["{{baseUrl}}"],
                            "path": ["columns", "00000000-0000-0000-0000-000000000000"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Delete Project",
                    "request": {
                        "method": "DELETE",
                        "url": {
                            "raw": "{{baseUrl}}/projects/{{projectId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["projects", "{{projectId}}"]
                        },
                        "description": "Soft delete (ADR §13): bloquea con 409 si el proyecto todavia tiene tareas en alguna columna. 'Delete Column' de este mismo folder ya elimino la columna de prueba, asi que en un run completo esto siempre deberia dar 204."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/auth/logout",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "logout"]
                        },
                        "description": "Revoca el JWT actual (blocklist por jti, ADR §16) -- ultimo request de la coleccion a proposito, ver la descripcion del folder."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
