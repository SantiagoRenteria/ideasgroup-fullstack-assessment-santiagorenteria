        {
            "name": "Projects",
            "item": [
                {
                    "name": "Create Project",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Migracion ERP\",\n  \"description\": \"Proyecto de prueba creado desde Postman\",\n  \"startDate\": \"{{futureStartDate}}\",\n  \"endDate\": \"{{futureEndDate}}\",\n  \"status\": \"Planned\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/projects",
                            "host": ["{{baseUrl}}"],
                            "path": ["projects"]
                        },
                        "description": "status: Planned | InProgress | Completed | Cancelled. startDate/endDate se calculan en el pre-request script (nunca hardcodeadas) porque la regla de negocio rechaza una fecha de inicio anterior a hoy -- una fecha fija se hubiera vuelto invalida con el paso del tiempo."
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const start = new Date();",
                                    "start.setDate(start.getDate() + 7);",
                                    "const end = new Date();",
                                    "end.setDate(end.getDate() + 180);",
                                    "pm.environment.set('futureStartDate', start.toISOString().slice(0, 10));",
                                    "pm.environment.set('futureEndDate', end.toISOString().slice(0, 10));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('201 Created', () => pm.response.to.have.status(201));",
                                    "const body = pm.response.json();",
                                    "pm.environment.set('projectId', body.id);",
                                    "pm.test('projectId guardado en el environment', () => pm.expect(body.id).to.be.a('string'));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "List Projects (paginado + filtro)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/projects?page=1&pageSize=10&name=&status=",
                            "host": ["{{baseUrl}}"],
                            "path": ["projects"],
                            "query": [
                                { "key": "page", "value": "1" },
                                { "key": "pageSize", "value": "10" },
                                { "key": "name", "value": "", "description": "coincidencia parcial, ej. 'erp'" },
                                { "key": "status", "value": "", "description": "Planned | InProgress | Completed | Cancelled" }
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('200 OK', () => pm.response.to.have.status(200));",
                                    "pm.test('respuesta paginada', () => {",
                                    "  const body = pm.response.json();",
                                    "  pm.expect(body).to.have.property('items');",
                                    "  pm.expect(body).to.have.property('totalCount');",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get Project By Id",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/projects/{{projectId}}",
                            "host": ["{{baseUrl}}"],
