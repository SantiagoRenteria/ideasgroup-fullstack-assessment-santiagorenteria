                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"luis.renteria@ideasgroup.test\",\n  \"password\": \"IdeasGroup2026!\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "login"]
                        },
                        "description": "Usuario semilla admin (ver migracion InitialCreate). El otro usuario semilla es evaluador@ideasgroup.test con la misma contraseña."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('200 OK', () => pm.response.to.have.status(200));",
                                    "const body = pm.response.json();",
                                    "pm.environment.set('token', body.token);",
                                    "pm.test('token guardado en el environment', () => pm.expect(body.token).to.be.a('string'));"
                                ]
                            }
